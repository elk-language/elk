##[
  Contains utilities for writing macros.
]##
module ::Std::Macro
  ##[
    A map that can be used in macros
    to store temporary info.
  ]##
  const STORE: HashMap[String, any]

  ##[
    Convert the given AST Node, or collection of nodes into
    an expression.
  ]##
  pure def expr(node: Elk::AST::StatementNode | ArrayTuple[Elk::AST::StatementNode]): Elk::AST::ExpressionNode; end

  ##[
    Wrap the given node in an unhygienic node.
    It enables macro-generated code to access
    local variables from outer scopes.
  ]##
  pure def unhygienic(node: Elk::AST::Node): Elk::AST::UnhygienicNode; end

  ##[
    Typecheck, compile and execute the given expression node.
    Can throw typechecker/compiler errors.
  ]##
  def eval_node(node: Elk::AST::ExpressionNode): any ! Elk::Type::Checker::Error; end

  ##[
    Tells the typechecker to append the given expression either at the end of the namespace
    or at the end of the file. The optional `key: String?` argument let's you
    deduplicate entries to avoid appending the same code multiple times.
  ]##
  def append_expression(context: Macro::Context, node: Elk::AST::ExpressionNode, kind: :end_of_namespace | :end_of_file, key: String = ""); end
end
