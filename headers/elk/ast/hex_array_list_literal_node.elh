module Std::Elk::AST
  ##[
    Represents a hex ArrayList literal eg. `\x[ff ee]`
  ]##
  sealed primitive class HexArrayListLiteralNode
    include LiteralPatternNode

    init(
      elements: ArrayTuple[IntCollectionContentNode] = loop; end,
      capacity: ExpressionNode? = nil,
      location: FS::Location = loop; end,
    ); end

    pure def elements: ArrayTuple[IntCollectionContentNode]; end
    pure def capacity: ExpressionNode?; end
    pure def location: FS::Location; end
  end
end
