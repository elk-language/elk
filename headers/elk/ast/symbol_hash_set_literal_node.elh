module Std::Elk::AST
  ##[
    Represents a symbol HashSet literal eg. `^s[foo bar]`
  ]##
  sealed primitive class SymbolHashSetLiteralNode
    include LiteralPatternNode

    init(
      elements: ArrayTuple[SymbolCollectionContentNode] = loop; end,
      capacity: ExpressionNode? = nil,
      location: FS::Location = loop; end,
    ); end

    pure def elements: ArrayTuple[SymbolCollectionContentNode]; end
    pure def capacity: ExpressionNode?; end
    pure def location: FS::Location; end
  end
end
