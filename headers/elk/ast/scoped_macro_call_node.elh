module Std::Elk::AST
  ##[
    Represents a scoped macro call eg. `Foo::bar!(5)`
  ]##
  sealed primitive class ScopedMacroCallNode
    include UsingEntryNode
    include TypeNode
    include ComplexConstantNode
    include LiteralPatternNode

    init(
      receiver: ExpressionNode,
      macro_name: IdentifierNode,
      kind: UInt8 = loop; end,
      positional_arguments: ArrayTuple[ExpressionNode] = loop; end,
      named_arguments: ArrayTuple[NamedArgumentNode] = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def receiver: ExpressionNode; end
    pure def macro_name: IdentifierNode; end
    pure def kind: UInt8; end
    pure def positional_arguments: ArrayTuple[ExpressionNode]; end
    pure def named_arguments: ArrayTuple[NamedArgumentNode]; end
    pure def location: FS::Location; end
  end
end
