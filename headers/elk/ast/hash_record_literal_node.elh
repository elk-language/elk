module Std::Elk::AST
  ##[
    Represents a Record literal eg. `%{ foo: 1, 'bar' => 5, baz }`
  ]##
  sealed primitive class HashRecordLiteralNode
    include ExpressionNode

    init(
      elements: ArrayTuple[ExpressionNode] = loop; end,
      location: FS::Location = loop; end
    ); end

    pure def elements: ArrayTuple[ExpressionNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
