module Std::Elk::AST
  ##[
    Represents a Range literal eg. `1...5`
  ]##
  sealed primitive class RangeLiteralNode
    include LiteralPatternNode

    init(
      start: ExpressionNode,
      end_node: ExpressionNode,
      op: Elk::Token = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def start: ExpressionNode; end
    pure def end: ExpressionNode; end
    pure def op: Elk::Token; end
    pure def location: FS::Location; end
  end
end
