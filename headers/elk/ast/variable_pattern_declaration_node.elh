module Std::Elk::AST
  ##[
    Represents a variable declaration with patterns eg. `var [foo, { bar }] = baz()`
  ]##
  sealed primitive class VariablePatternDeclarationNode
    include ExpressionNode

    init(pattern_node: PatternNode, initialiser: ExpressionNode, location: FS::Location = loop; end); end
    pure def pattern_node: PatternNode; end
    pure def initialiser: ExpressionNode; end
    pure def location: FS::Location; end
  end
end
