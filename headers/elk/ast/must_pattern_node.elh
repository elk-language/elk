module Std::Elk::AST
  ##[
    Represents a `must` pattern eg. `must`
  ]##
  sealed primitive class MustPatternNode
    include PatternNode

    init(location: FS::Location = loop; end); end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
