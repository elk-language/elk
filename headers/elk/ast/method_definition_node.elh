module Std::Elk::AST
  ##[
    Represents a method definition eg. `def foo: String then 'hello world'`
  ]##
  sealed primitive class MethodDefinitionNode
    include ExpressionNode

    const ABSTRACT_FLAG: UInt8
    const SEALED_FLAG: UInt8
    const GENERATOR_FLAG: UInt8
    const ASYNC_FLAG: UInt8
    const OVERLOAD_FLAG: UInt8
    const PURE_FLAG: UInt8

    init(
      name: IdentifierNode,
      type_parameters: ArrayTuple[TypeParameterNode] = loop; end,
      parameters: ArrayTuple[ParameterNode] = loop; end,
      return_type: TypeNode? = nil,
      throw_type: TypeNode? = nil,
      body: ArrayTuple[StatementNode] = loop; end,
      flags: UInt8 = 0u8,
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def name: IdentifierNode; end
    pure def type_parameters: ArrayTuple[TypeParameterNode]; end
    pure def parameters: ArrayTuple[ParameterNode]; end
    pure def return_type: TypeNode; end
    pure def throw_type: TypeNode; end
    pure def body: ArrayTuple[StatementNode]; end
    pure def flags: UInt8; end
    pure def location: FS::Location; end

    ##[
      Whether the method is abstract eg. `abstract def foo; end`
    ]##
    pure def is_abstract: bool; end

    ##[
      Whether the method is sealed eg. `sealed def foo; end`
    ]##
    pure def is_sealed: bool; end

    ##[
      Whether the method is a generator eg. `def* foo; end`
    ]##
    pure def is_generator: bool; end

    ##[
      Whether the method is asynchronous eg. `async def foo; end`
    ]##
    pure def is_async: bool; end

    ##[
      Whether the method is an overload eg. `overload def foo; end`
    ]##
    pure def is_overload: bool; end

    ##[
      Whether the method is pure so has no side effects.
    ]##
    pure def is_pure: bool; end
  end
end
