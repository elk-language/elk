module Std::Elk::AST
  ##[
    Represents a select `case` node eg. `case v := <<ch then println(v)`
  ]##
  sealed primitive class SelectCaseNode
    init(
      expression_node: ExpressionNode,
      body: Tuple[StatementNode],
      location: FS::Location = loop; end,
    ); end

    pure def expression_node: ExpressionNode; end
    pure def body: ArrayTuple[StatementNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
