module Std::Elk::AST
  ##[
    Represents a nilable pattern eg. `5?`
  ]##
  sealed primitive class NilablePatternNode
    include PatternNode

    init(pattern_node: PatternNode, location: FS::Location = loop; end); end
    pure def pattern_node: PatternNode; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
