module Std::Elk::AST
  ##[
    Represents a `yield` expression eg. `yield`, `yield true`, `yield* foo()`
  ]##
  sealed primitive class YieldExpressionNode
    include ExpressionNode

    init(
      value: ExpressionNode? = nil,
      forward: bool = false,
      location: FS::Location = loop; end,
    ); end

    pure def value: ExpressionNode?; end
    pure def forward: Bool; end
    pure def location: FS::Location; end
  end
end
