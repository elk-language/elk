module Std::Elk::AST
  ##[
    Represents an `unless` expression eg. `unless foo then println("bar")`
  ]##
  sealed primitive class UnlessExpressionNode
    include ExpressionNode

    init(
      condition: ExpressionNode,
      then_body: Tuple[StatementNode] = loop; end,
      else_body: Tuple[StatementNode] = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def condition: ExpressionNode; end
    pure def then_body: ArrayTuple[StatementNode]; end
    pure def else_body: ArrayTuple[StatementNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
