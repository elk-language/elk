module Std::Elk::AST
  ##[
    Represents a generic function-like call eg. `foo::[Int](123)`
  ]##
  sealed primitive class GenericReceiverlessMethodCallNode
    include ExpressionNode

    init(
      method_name: IdentifierNode,
      type_arguments: ArrayTuple[TypeNode],
      positional_arguments: ArrayTuple[ExpressionNode] = loop; end,
      named_arguments: ArrayTuple[NamedArgumentNode] = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def method_name: IdentifierNode; end
    pure def type_arguments: ArrayTuple[TypeNode]; end
    pure def positional_arguments: ArrayTuple[ExpressionNode]; end
    pure def named_arguments: ArrayTuple[NamedArgumentNode]; end
    pure def location: FS::Location; end
  end
end
