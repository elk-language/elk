module Std::Elk::AST
  ##[
    Represents a symbol literal with simple content eg. `:foo`, `:'foo bar`, `:"lol"`
  ]##
  sealed primitive class SimpleSymbolLiteralNode
    include LiteralPatternNode,
            TypeNode,
            SymbolCollectionContentNode,
            SymbolLiteralNode

    init(content: String, location: FS::Location = loop; end); end
    pure def content: String; end
    pure def location: FS::Location; end
    pure def to_symbol: Symbol; end

    pure def to_ast_ident_node: IdentifierNode; end
  end
end
