module Std::Elk::AST
  ##[
    `undefined` literal.
  ]##
  sealed primitive class UndefinedLiteralNode
    include ExpressionNode

    init(location: FS::Location = loop; end); end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
