module Std::Elk::AST
  ##[
    Represents an attribute declaration in getters, setters and accessors eg. `foo: String`
  ]##
  sealed primitive class AttributeParameterNode
    include ParameterNode

    init(
      name: IdentifierNode,
      type_node: TypeNode? = nil,
      initialiser: ExpressionNode? = nil,
      location: FS::Location = loop; end,
    ); end

    pure def name: IdentifierNode; end
    pure def type_node: TypeNode?; end
    pure def initialiser: ExpressionNode?; end
    pure def location: FS::Location; end

		##[
			Whether the parameter is optional.
			eg. `foo?: String`
		]##
		pure def is_optional: bool; end

		pure def is_normal: bool; end
		pure def is_positional_rest: bool; end
		pure def is_named_rest: bool; end

  end
end
