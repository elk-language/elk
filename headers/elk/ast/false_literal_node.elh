module Std::Elk::AST
  ##[
    `false` literal.
  ]##
  sealed primitive class FalseLiteralNode
    include LiteralPatternNode,
            TypeNode

    init(location: FS::Location = loop; end); end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
