module Std::Elk::AST
  ##[
    Represents a `do` expression eg.

    ```
    do
      print("awesome!")
    end
    ```
  ]##
  sealed primitive class DoExpressionNode
    include ExpressionNode

    init(
      body: ArrayTuple[StatementNode] = loop; end,
      catches: ArrayTuple[CatchNode] = loop; end,
      finally_body: ArrayTuple[StatementNode] = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def body: ArrayTuple[StatementNode]; end
    pure def catches: ArrayTuple[CatchNode]; end
    pure def finally_body: ArrayTuple[StatementNode]; end
    pure def location: FS::Location; end
  end
end
