module Std::Elk::AST
  ##[
    Represents a constant declaration eg. `const Foo: ArrayList[String] = ["foo", "bar"]`
  ]##
  sealed primitive class ConstantDeclarationNode
    include ExpressionNode

    init(
      constant: ExpressionNode,
      type_node: TypeNode? = nil,
      initialiser: ExpressionNode? = nil,
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def constant: ExpressionNode; end
    pure def type_node: TypeNode?; end
    pure def initialiser: ExpressionNode?; end
    pure def location: FS::Location; end
  end
end
