module Std::Elk::AST
  ##[
    Represents a public identifier eg. `foo`.
  ]##
  sealed primitive class PublicIdentifierNode
    include LiteralPatternNode,
            UsingSubentryNode,
            IdentifierNode

    init(value: String, location: FS::Location = loop; end); end
    pure def value: String; end
    pure def location: FS::Location; end
    pure def to_symbol: Symbol; end
  end
end
