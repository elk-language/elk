module Std::Elk::AST
  ##[
    Represents a new generic type definition eg. `typedef Nilable[T] = T | nil`
  ]##
  sealed primitive class GenericTypeDefinitionNode
    include ExpressionNode

    init(
      constant: ComplexConstantNode,
      type_parameters: ArrayTuple[TypeParameterNode],
      type_node: TypeNode,
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def type_parameters: ArrayTuple[TypeParameterNode]; end
    pure def constant: ComplexConstantNode; end
    pure def type_node: TypeNode; end
    pure def location: FS::Location; end
  end
end
