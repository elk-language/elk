module Std::Elk::AST
  ##[
    Represents an `await` expression eg. `await foo()`
  ]##
  sealed primitive class AwaitExpressionNode
    include ExpressionNode

    init(value: ExpressionNode, sync: Bool = false, location: FS::Location = loop; end); end
    pure def value: ExpressionNode; end
    pure def sync: Bool; end
    pure def location: FS::Location; end
  end
end
