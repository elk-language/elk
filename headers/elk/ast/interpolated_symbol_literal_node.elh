module Std::Elk::AST
  ##[
    Represents an interpolated symbol eg. `:"foo ${bar + 2}"`
  ]##
  sealed primitive class InterpolatedSymbolLiteralNode
    include LiteralPatternNode,
            TypeNode,
            SymbolLiteralNode

    init(content: InterpolatedStringLiteralNode, location: FS::Location = loop; end); end
    pure def content: InterpolatedStringLiteralNode; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
