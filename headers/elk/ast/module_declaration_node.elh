module Std::Elk::AST
  ##[
    Represents a module declaration eg. `module Foo; end`
  ]##
  sealed primitive class ModuleDeclarationNode
    include ExpressionNode

    init(
      constant: ExpressionNode,
      body: Tuple[StatementNode] = loop; end,
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def constant: ExpressionNode?; end
    pure def body: ArrayTuple[StatementNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
