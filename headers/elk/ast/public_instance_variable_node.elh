module Std::Elk::AST
  ##[
    Represents an instance variable eg. `@foo`
  ]##
  sealed primitive class PublicInstanceVariableNode
    include ExpressionNode,
            InstanceVariableNode

    init(value: String, location: FS::Location = loop; end); end
    pure def value: String; end
    pure def location: FS::Location; end
    pure def to_symbol: Symbol; end
  end
end
