module Std::Elk::AST
  ##[
    Represents a word ArrayTuple literal eg. `%w[foo bar]`
  ]##
  sealed primitive class WordArrayTupleLiteralNode
    include LiteralPatternNode

    init(
      elements: ArrayTuple[WordCollectionContentNode] = loop; end,
      location: FS::Location = loop; end,
    ); end

    pure def elements: ArrayTuple[WordCollectionContentNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
