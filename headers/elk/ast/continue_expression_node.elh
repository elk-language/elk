module Std::Elk::AST
  ##[
    Represents a `continue` expression eg. `continue`, `continue "foo"`
  ]##
  sealed primitive class ContinueExpressionNode
    include ExpressionNode

    init(
      label: IdentifierNode? = nil,
      value: ExpressionNode? = nil,
      location: FS::Location = loop; end,
    ); end

    pure def label: IdentifierNode?; end
    pure def value: ExpressionNode?; end
    pure def location: FS::Location; end
  end
end
