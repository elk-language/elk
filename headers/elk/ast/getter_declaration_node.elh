module Std::Elk::AST
  ##[
    Represents a new getter declaration eg. `getter foo: String`
  ]##
  sealed primitive class GetterDeclarationNode
    include ExpressionNode

    const PURE_FLAG: UInt8

    init(
      entries: ArrayTuple[ParameterNode],
      flags: UInt8 = 0u8,
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def entries: ArrayTuple[ParameterNode]; end
    pure def location: FS::Location; end
    pure def flags: UInt8; end

    pure def is_pure: bool; end
  end
end
