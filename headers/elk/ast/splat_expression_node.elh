module Std::Elk::AST
  ##[
    Represents a splat expression eg. `*foo`
  ]##
  sealed primitive class SplatExpressionNode
    include ExpressionNode

    init(value: ExpressionNode, location: FS::Location = loop; end); end
    pure def value: ExpressionNode; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
