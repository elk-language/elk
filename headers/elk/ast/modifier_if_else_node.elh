module Std::Elk::AST
  ##[
    Represents an `if .. else` modifier expression eg. `foo = 1 if bar else foo = 2`
  ]##
  sealed primitive class ModifierIfElseNode
    include ExpressionNode

    init(
      then_expression: ExpressionNode,
      condition: ExpressionNode,
      else_expression: ExpressionNode,
      location: FS::Location = loop; end,
    ); end

    pure def then_expression: ExpressionNode; end
    pure def condition: ExpressionNode; end
    pure def else_expression: ExpressionNode; end
    pure def location: FS::Location; end
  end
end
