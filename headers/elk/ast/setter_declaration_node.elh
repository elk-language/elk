module Std::Elk::AST
  ##[
    Represents a new setter declaration eg. `setter foo: String`
  ]##
  sealed primitive class SetterDeclarationNode
    include ExpressionNode

    init(
      entries: ArrayTuple[ParameterNode],
      doc_comment: String = "",
      location: FS::Location = loop; end,
    ); end

    pure def doc_comment: String; end
    pure def entries: ArrayTuple[ParameterNode]; end
    pure def location: FS::Location; end
  end
end
