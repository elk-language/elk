module Std::Elk::AST
  ##[
    Represents an interpolated string literal eg. `"foo ${bar} baz"`
  ]##
  sealed primitive class InterpolatedStringLiteralNode
    include LiteralPatternNode,
            TypeNode,
            StringLiteralNode

    init(content: Tuple[StringLiteralContentNode], location: FS::Location = loop; end); end
    pure def content: ArrayTuple[StringLiteralContentNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
