module Std::Elk::AST
  ##[
    Exact type of a class instance eg. `exact Foo`, `exact Bar[String]`
  ]##
  sealed primitive class ExactTypeNode
    include TypeNode

    init(type_node: TypeNode, location: FS::Location = loop; end); end
    pure def type_node: TypeNode; end
    pure def location: FS::Location; end
  end
end
