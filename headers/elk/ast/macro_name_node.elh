module Std::Elk::AST
  ##[
    Represents a macro name eg. `foo!`.
  ]##
  sealed primitive class MacroNameNode
    include UsingSubentryNode,
            IdentifierNode,
            LiteralPatternNode

    init(value: String, location: FS::Location = loop; end); end
    pure def value: String; end
    pure def location: FS::Location; end
    pure def to_symbol: Symbol; end
  end
end
