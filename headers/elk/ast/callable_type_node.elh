module Std::Elk::AST
  ##[
    Represents a callable type eg. `|i: Int|: String`
  ]##
  sealed primitive class CallableTypeNode
    include TypeNode

    init(
      parameters: ArrayTuple[ParameterNode] = loop; end,
      return_type: TypeNode? = nil,
      throw_type: TypeNode? = nil,
      location: FS::Location = loop; end,
      is_closure: bool = false,
      is_pure: bool = false,
    ); end

    pure def parameters: ArrayTuple[ParameterNode]; end
    pure def return_type: TypeNode?; end
    pure def throw_type: TypeNode?; end
    pure def is_closure: bool; end
    pure def is_pure: bool; end
    pure def location: FS::Location; end
  end
end
