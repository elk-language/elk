module Std::Elk::AST
  ##[
    Union type eg. `String | Int | Float`
  ]##
  sealed primitive class UnionTypeNode
    include TypeNode

    init(elements: Tuple[TypeNode], location: FS::Location = loop; end); end
    pure def elements: ArrayTuple[TypeNode]; end
    pure def location: FS::Location; end
    pure def ==(other: any): bool; end
    pure def =~(other: any): bool; end
  end
end
