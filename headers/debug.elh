##[
  Contains various debugging utilities.
]##
module Std::Debug
  def start_cpu_profile(file_path: String)! FileSystemError; end
  def stop_cpu_profile; end

  def inspect_value_stack; end

  def inspect_call_stack; end

  ##[
    Returns the current stack trace.
  ]##
  def stack_trace: StackTrace; end

  def inspect_inheritance(klass: Class): String; end

  ##[
    Returns the name of the native type of the value.
  ]##
  pure def inspect_native_type(value: any): String; end

  ##[
    Prints the disassembly of the current
    bytecode method.

    Throws an unchecked error when the current method
    does not have bytecode (is native).
  ]##
  pure def inspect_current_bytecode; end

  ##[
    Prints the disassembly of the parent
    bytecode method.

    Throws an unchecked error when the parent method
    does not have bytecode (is native).
  ]##
  pure def inspect_parent_bytecode; end

  ##[
    Prints the disassembly of the current
    bytecode method.

    Throws an unchecked error when the current method
    does not have bytecode (is native).
  ]##
  pure def inspect_bytecode(method: Closure); end
end
