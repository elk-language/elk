describe "StringBuilder" ->

	context "init" ->
		should "create a new empty object" ->
			sb := Std::StringBuilder()
			assert! sb <<: Std::StringBuilder
			assert! sb.is_empty == true
			assert! sb.inspect == "Std::StringBuilder(\"\")"
		end

		should "create a new object with string as a param" ->
			sb := Std::StringBuilder("foo")
			assert! sb <<: Std::StringBuilder
			assert! sb.is_empty == false
			assert! sb.inspect == "Std::StringBuilder(\"foo\")"
		end

		should "create a new object with char as a param" ->
			sb := Std::StringBuilder('f')
			assert! sb <<: Std::StringBuilder
			assert! sb.is_empty == false
			assert! sb.inspect == "Std::StringBuilder(\"f\")"
		end

		should "create a new object with byte as a param" ->
			sb := Std::StringBuilder(10u8)
			assert! sb <<: Std::StringBuilder
			assert! sb.is_empty == false
			assert! sb.inspect == "Std::StringBuilder(\"\\n\")"
		end
	end

	context "<<" ->
		context "empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << "foo" <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << 'f' <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"f\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << 10u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"\\n\")"
			end

			should "append multiple strings" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << "foo" << "bar" <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foobar\")"
			end

			should "append multiple chars" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << 'f' << 'b' <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"fb\")"
			end

			should "append multiple bytes" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << 10u8 << 12u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"\\n\\f\")"
			end

			should "chain multiple appends with different type params" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb << "foo" << 'f' << 10u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foof\\n\")"
			end
		end

		context "non empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << "foo" <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << 'f' <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pouf\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << 10u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pou\\n\")"
			end

			should "append multiple strings" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << "foo" << "bar" <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoobar\")"
			end

			should "append multiple chars" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << 'f' << 'b' <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufb\")"
			end

			should "append multiple bytes" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << 10u8 << 12u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pou\\n\\f\")"
			end

			should "chain multiple appends with different type params" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb << "foo" << 'f' << 10u8 <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoof\\n\")"
			end
		end
	end

	context "push" ->
		context "empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push("foo") <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push('f') <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"f\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push(10u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"\\n\")"
			end

			should "append multiple strings" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push("foo").push("bar") <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foobar\")"
			end

			should "append multiple chars" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push('f').push('b') <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"fb\")"
			end

			should "append multiple bytes" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push(10u8).push(12u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"\\n\\f\")"
			end

			should "chain multiple appends with different type params" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.push("foo").push('f').push(10u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"foof\\n\")"
			end
		end

		context "non empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push("foo") <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push('f') <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pouf\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push(10u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pou\\n\")"
			end

			should "append multiple strings" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push("foo").push("bar") <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoobar\")"
			end

			should "append multiple chars" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push('f').push('b') <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufb\")"
			end

			should "append multiple bytes" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push(10u8).push(12u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"pou\\n\\f\")"
			end

			should "chain multiple appends with different type params" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.push("foo").push('f').push(10u8) <<: Std::StringBuilder
				assert! sb.inspect == "Std::StringBuilder(\"poufoof\\n\")"
			end
		end
	end

	context "write" ->
		context "empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.write("foo") == 3
				assert! sb.inspect == "Std::StringBuilder(\"foo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.write('f') == 1
				assert! sb.inspect == "Std::StringBuilder(\"f\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder()
				assert! sb.is_empty == true

				assert! sb.write(10u8) == 1
				assert! sb.inspect == "Std::StringBuilder(\"\\n\")"
			end
		end

		context "non empty buffer" ->
			should "append string" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.write("foo") == 3
				assert! sb.inspect == "Std::StringBuilder(\"poufoo\")"
			end

			should "append char" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.write('f') == 1
				assert! sb.inspect == "Std::StringBuilder(\"pouf\")"
			end

			should "append byte" ->
				sb := Std::StringBuilder("pou")
				assert! sb.is_empty == false

				assert! sb.write(10u8) == 1
				assert! sb.inspect == "Std::StringBuilder(\"pou\\n\")"
			end
		end
	end

	context "to_string" ->
		should "return string from empty buffer" ->
			sb := Std::StringBuilder()
			assert! sb.is_empty == true

			s := sb.to_string
			assert! s <<: Std::String
			assert! s == ""
		end

		should "return string from non empty buffer" ->
			sb := Std::StringBuilder("foo")
			assert! sb.is_empty == false

			s := sb.to_string
			assert! s <<: Std::String
			assert! s == "foo"
		end
	end

	context "inspect" ->
		should "return string representing empty buffer" ->
			sb := Std::StringBuilder()
			assert! sb.is_empty == true

			s := sb.inspect
			assert! s <<: Std::String
			assert! s == "Std::StringBuilder(\"\")"
		end

		should "return string representing non empty buffer" ->
			sb := Std::StringBuilder("foo")
			assert! sb.is_empty == false

			s := sb.inspect
			assert! s <<: Std::String
			assert! s == "Std::StringBuilder(\"foo\")"
		end
	end

	context "length" ->
		should "return how many bytes are stored in buffer" ->
			sb := Std::StringBuilder()

			sb << "foo" << 'f' << 10u8
			assert! sb.length == 5

			s := sb.to_string
			assert! sb.length == s.length
		end
	end

	context "capacity" ->
		should "return capacity with empty buffer" ->
			sb := Std::StringBuilder()

			assert! sb.capacity == 0
		end

		should "return capacity non with empty buffer" ->
			sb := Std::StringBuilder("foo")

			assert! sb.capacity == 8
		end
	end

	context "grow" ->
		should "don't increase capacity if its lower than current capacity" ->
			sb := Std::StringBuilder("foo")

			assert! sb.capacity == 8
			sb.grow(5)

			assert! sb.capacity == 8
		end

		should "increase capacity for non empty buffer" ->
			sb := Std::StringBuilder("foo")

			assert! sb.capacity == 8
			sb.grow(13)

			assert! sb.capacity == 32
		end

		should "increase capacity for empty buffer" ->
			sb := Std::StringBuilder()

			assert! sb.capacity == 0
			sb.grow(13)

			assert! sb.capacity == 16
		end
	end

	context "reset" ->
		should "clear with empty buffer" ->
			sb := Std::StringBuilder()
			assert! sb.is_empty == true
			assert! sb.length == 0
			assert! sb.capacity == 0

			sb.reset

			assert! sb.is_empty == true
			assert! sb.length == 0
			assert! sb.capacity == 0
		end

		should "clear with non empty buffer" ->
			sb := Std::StringBuilder("foo")
			assert! sb.is_empty == false
			assert! sb.length == 3
			assert! sb.capacity == 8

			sb.reset

			assert! sb.is_empty == true
			assert! sb.length == 0
			assert! sb.capacity == 0
		end
	end

	context "is_empty" ->
		should "return true if empty" ->
			sb := Std::StringBuilder("")
			assert! sb.is_empty == true
			assert! sb.to_string.is_empty == true
		end

		should "return false if not empty" ->
			sb := Std::StringBuilder("foo")
			assert! sb.is_empty == false
			assert! sb.to_string.is_empty == false
		end
	end

end
